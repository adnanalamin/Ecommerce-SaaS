# NEXORA Multi-Tenant SaaS E-Commerce Platform Configuration
# Copy this file to .env.local or set variables in your deployment environment.
# NEVER commit real secrets or .env files to version control.

# Server Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# AI Studio injected secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database Configuration (MongoDB)
MONGODB_URI="mongodb://localhost:27017/nexora_dev"
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Distributed Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Cryptographic Secrets (MUST be replaced with 256-bit random values in production)
JWT_ACCESS_SECRET="nexora_dev_jwt_access_secret_32_characters_minimum"
JWT_REFRESH_SECRET="nexora_dev_jwt_refresh_secret_32_characters_minimum"
COOKIE_SECRET="nexora_dev_cookie_signing_secret_32_chars_min"
CSRF_SECRET="nexora_dev_csrf_hmac_secret_32_characters_minimum"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CORS & Domains
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
PLATFORM_DOMAIN="nexora.shop"

# Rate Limiting & Request Guardrails
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=15
MAX_REQUEST_BODY_SIZE="1mb"
MAX_JSON_DEPTH=20
TRUST_PROXY_HOPS=1
MAX_UPLOAD_FILE_BYTES=5242880

# Logging & Telemetry
LOG_LEVEL="debug"
